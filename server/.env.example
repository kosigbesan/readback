# Copy to .env and fill in. Never commit the real file.

# Where the app is served from, used for the Stripe redirect back
PUBLIC_BASE=https://kosigbesan.github.io/readback

# Stripe. Test keys start with sk_test_ and will not move real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Create these in the Stripe dashboard: Product catalogue, then copy each price id
STRIPE_PRICE_SPRINT=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# The voice proxy key. This is why the key is not in the app any more.
ELEVENLABS_API_KEY=

# Optional
ADMIN_TOKEN=
ALLOWED_ORIGINS=*
PORT=8787
